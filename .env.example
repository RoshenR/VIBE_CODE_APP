# --- Base de données ---------------------------------------------------------
# Le conteneur PostgreSQL est publié sur 5433 (voir POSTGRES_PORT plus bas) :
# une installation locale de PostgreSQL occupe souvent 5432.
DATABASE_URL=postgresql://nuits:nuits@localhost:5433/nuits

# Port hôte du conteneur PostgreSQL.
POSTGRES_PORT=5433
# Mot de passe de la base. À changer en production, évidemment.
POSTGRES_PASSWORD=nuits

# Chiffrement de la liaison avec PostgreSQL.
#   (vide)  → clair. Acceptable uniquement si la base est sur la même machine.
#   require → TLS, certificat non vérifié. Minimum dès que la base est distante.
#   strict  → TLS avec certificat vérifié. La cible.
DATABASE_SSL=

# --- Secrets -----------------------------------------------------------------
# CES TROIS VALEURS SONT PUBLIQUES : elles figurent dans le dépôt.
# L'application REFUSE DE DÉMARRER en production tant qu'elles sont en place.
#
# Générez-en de nouvelles, distinctes, d'au moins 32 caractères :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Signature des QR codes des billets. Le changer invalide tous les billets émis.
TICKET_SIGNING_SECRET=dev-ticket-secret-a-changer-absolument
# Signature des liens envoyés par e-mail (gestion de commande, offres, 2FA).
LINK_SIGNING_SECRET=dev-link-secret-a-changer-absolument
# Secret partagé avec le prestataire de paiement pour valider ses notifications.
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-a-changer-absolument

# --- Paiement ----------------------------------------------------------------
# simulator = prestataire factice intégré (dev/recette). Voir src/server/payments/
PAYMENT_PROVIDER=simulator
# Garde-fou : le simulateur reste inaccessible en production, sauf mise à `true`.
# Ne l'activez jamais sur une instance qui vend de vraies places.
ALLOW_PAYMENT_SIMULATOR=false

# --- E-mail ------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Les Nuits de la Garonne <billetterie@nuitsdelagaronne.fr>"

# --- Application -------------------------------------------------------------
APP_URL=http://localhost:3000
NODE_ENV=development

# --- Sécurité ----------------------------------------------------------------
# Origines supplémentaires autorisées à envoyer des requêtes (séparées par des
# virgules). Utile derrière un nom de domaine secondaire. Laisser vide sinon.
ADDITIONAL_ORIGINS=

# `X-Forwarded-For` n'est lu que si cette valeur est `true`.
#
# À n'activer QUE derrière un proxy inverse de confiance (nginx, Traefik,
# Cloudflare). Sinon, n'importe qui choisit l'adresse qu'il déclare et contourne
# toutes les limitations de débit en changeant de valeur à chaque requête.
TRUST_PROXY=false
